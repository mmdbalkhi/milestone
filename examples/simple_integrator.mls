problem SimpleIntegrator
  state: x
  control: u
  parameter: dt = 0.1
  dynamics:
    x' = x + dt * u
  end_dynamics
  initial:
    x = 0
  end_initial
  horizon: 30
  bounds:
    x in [-5, 10]
    u in [-3, 3]
  end_bounds
  cost:
    running = 0.1 * u^2
    terminal = (x - 3)^2
  end_cost
  solve:
    method = dynamic_programming
    grid = [61]
    controls = 21
  end_solve
end_problem
