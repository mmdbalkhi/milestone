# 1D thermal regulation with heat loss and control effort penalty
problem RoomTemperatureControl
    state:
        T
    control:
        u
    parameter:
        dt = 0.2
        alpha = 0.15
        T_amb = 5.0
        beta = 0.8
        T_ref = 20.0
        u_weight = 0.05
        term_weight = 20.0
    dynamics:
        T' = T + dt * (-alpha * (T - T_amb) + beta * u)
    end_dynamics
    initial:
        T = 10.0
    end_initial
    horizon: 25
    bounds:
        T in [0.0, 30.0]
        u in [0.0, 10.0]
    end_bounds
    cost:
        running = (T - T_ref)^2 + u_weight * u^2
        terminal = term_weight * (T - T_ref)^2
    end_cost
    solve:
        method = dynamic_programming
        grid = [61]
        controls = 21
    end_solve
end_problem
