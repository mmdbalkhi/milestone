# Double Integrator optimal control example
problem DoubleIntegrator
    state:
        x, v
    control:
        u
    parameter:
        dt = 0.1
    dynamics:
        x' = x + dt * v
        v' = v + dt * u
    end_dynamics
    initial:
        x = 0
        v = 0
    end_initial
    target:
        x = 10
        v = 0
    end_target
    horizon: 20
    bounds:
        x in [-15, 15]
        v in [-10, 10]
        u in [-2, 2]
    end_bounds
    cost:
        running = x^2 + v^2 + 0.1 * u^2
        terminal = 10 * (x - 10)^2 + 10 * v^2
    end_cost
    solve:
        method = dynamic_programming
        grid = [41, 41]
        controls = 21
    end_solve
end_problem
