problem ReactorCooling
  state: C, T
  control: u
  parameter:
    dt = 0.2
    ambient = 25.0
    target_temp = 35.0
  dynamics:
    C' = C + dt * (-0.1 * C)
    T' = T + dt * (2.0 * C - 0.15 * (T - ambient) - 0.5 * u)
  end_dynamics
  initial:
    C = 5.0
    T = 30.0
  end_initial
  horizon: 20
  bounds:
    C in [0.0, 6.0]
    T in [20.0, 60.0]
    u in [0.0, 10.0]
  end_bounds
  cost:
    running = (T - target_temp)^2 + 0.02 * u^2
    terminal = 10.0 * (T - target_temp)^2
  end_cost
  solve:
    method = dynamic_programming
    grid = [21, 21]
    controls = 11
  end_solve
end_problem
