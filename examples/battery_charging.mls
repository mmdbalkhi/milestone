problem BatteryCharging
  state: soc, temp
  control: I
  parameter:
    dt = 0.2
    ambient = 25.0
    target_soc = 0.9
    target_temp = 30.0
  dynamics:
    soc' = soc + dt * 0.02 * I
    temp' = temp + dt * (0.08 * I^2 - 0.1 * (temp - ambient))
  end_dynamics
  initial:
    soc = 0.2
    temp = 25.0
  end_initial
  horizon: 20
  bounds:
    soc in [0.0, 1.0]
    temp in [20.0, 50.0]
    I in [0.0, 5.0]
  end_bounds
  cost:
    running = 0.1 * I^2 + 0.2 * (temp - target_temp)^2
    terminal = 100.0 * (soc - target_soc)^2
             + 10.0 * (temp - target_temp)^2
  end_cost
  solve:
    method = dynamic_programming
    grid = [21, 21]
    controls = 11
  end_solve
end_problem
